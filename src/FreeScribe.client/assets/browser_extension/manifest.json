{
  "manifest_version": 3,
  "name": "FreeScribe for OSCAR",
  "version": "1.5.0",
  "description": "Control FreeScribe during a visit, dictate into the chart and its forms, and put the finished note into OSCAR with one click, from a floating panel that also works in OSCAR's pop-up chart windows. Talks only to FreeScribe on this computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FreeScribe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start recording, or stop and write the note"
    },
    "pause-resume": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume the recording"
    },
    "dictate": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Dictate into the chart where the cursor is (press again to stop)"
    },
    "insert-note": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Insert the note where the cursor is in the EMR"
    }
  }
}
